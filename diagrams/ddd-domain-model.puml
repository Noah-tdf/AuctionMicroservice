@startuml
' DDD-PlantUML style domain model for the Auction Microservices System.
' Stereotypes identify bounded contexts, aggregate roots, entities,
' value objects, repositories, domain services, and domain exceptions.

hide empty members
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle

skinparam class {
  BackgroundColor<<Aggregate Root>> #FFF2CC
  BackgroundColor<<Entity>> #DAE8FC
  BackgroundColor<<Value Object>> #E1D5E7
  BackgroundColor<<Repository>> #D5E8D4
  BackgroundColor<<Domain Service>> #F8CECC
  BackgroundColor<<Domain Exception>> #FCE5CD
}

title DDD Domain Model - Auction Microservices

package "Auction Orchestration BC" <<Bounded Context>> {
  class Auction <<Aggregate Root>> {
    auctionId
    listingId
    sellerId
    startTime
    endTime
    startingPrice
    currentPrice
    status
    schedule()
    activate()
    close()
    deleteIfNoBids()
  }

  class Bid <<Entity>> {
    bidId
    bidderId
    bidAmount
    bidTime
  }

  class AuctionMoney <<Value Object>> {
    amount
    currency
  }

  enum AuctionStatus <<Value Object>> {
    SCHEDULED
    ACTIVE
    CLOSED
  }

  interface AuctionRepository <<Repository>>
  interface BidRepository <<Repository>>
  class AuctionApplicationService <<Domain Service>>
  class AuctionHasBidsException <<Domain Exception>>
  class AuctionInvariantViolationException <<Domain Exception>>

  Auction *-- "0..*" Bid
  Auction *-- AuctionMoney : price
  Bid *-- AuctionMoney : amount
  Auction --> AuctionStatus
  AuctionApplicationService --> AuctionRepository
  AuctionApplicationService --> BidRepository
  AuctionApplicationService ..> AuctionHasBidsException
  AuctionApplicationService ..> AuctionInvariantViolationException
}

package "User Management BC" <<Bounded Context>> {
  class User <<Aggregate Root>> {
    userId
    username
    email
    registrationDate
    verified
    rating
  }

  class Address <<Value Object>> {
    street
    city
    province
    postalCode
  }

  class Email <<Value Object>> {
    value
  }

  interface UserRepository <<Repository>>
  class UserApplicationService <<Domain Service>>
  class DuplicateEmailException <<Domain Exception>>

  User *-- Address
  User *-- Email
  UserApplicationService --> UserRepository
  UserApplicationService ..> DuplicateEmailException
}

package "Listing Management BC" <<Bounded Context>> {
  class Listing <<Aggregate Root>> {
    listingId
    sellerId
    title
    description
    category
    condition
    published
    publish()
  }

  enum ListingCondition <<Value Object>> {
    NEW
    USED
    REFURBISHED
  }

  interface ListingRepository <<Repository>>
  class ListingApplicationService <<Domain Service>>
  class ListingAlreadyPublishedException <<Domain Exception>>

  Listing --> ListingCondition
  ListingApplicationService --> ListingRepository
  ListingApplicationService ..> ListingAlreadyPublishedException
}

package "Payment Processing BC" <<Bounded Context>> {
  class Invoice <<Aggregate Root>> {
    invoiceId
    auctionId
    buyerId
    sellerId
    finalSaleAmount
    issueDate
    dueDate
    status
    method
    pay()
  }

  class InvoiceMoney <<Value Object>> {
    amount
    currency
  }

  enum InvoiceStatus <<Value Object>> {
    PENDING
    PAID
  }

  enum PaymentMethod <<Value Object>> {
    CREDIT_CARD
    BANK_TRANSFER
    CASH
  }

  interface InvoiceRepository <<Repository>>
  class InvoiceApplicationService <<Domain Service>>
  class InvoiceAlreadyPaidException <<Domain Exception>>

  Invoice *-- InvoiceMoney : finalSaleAmount
  Invoice --> InvoiceStatus
  Invoice --> PaymentMethod
  InvoiceApplicationService --> InvoiceRepository
  InvoiceApplicationService ..> InvoiceAlreadyPaidException
}

note bottom of Auction
  Milestone 1 rule:
  each bounded context owns its aggregate,
  repository, database, and domain exception.
end note

note bottom of Listing
  Cross-service aggregate composition is left
  out of the domain model for Milestone 1.
end note

@enduml
