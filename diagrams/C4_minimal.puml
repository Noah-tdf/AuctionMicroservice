' Minimal local C4-PlantUML-compatible macros used for offline rendering.
' These macros intentionally cover only the constructs used by this project.

skinparam shadowing false
skinparam rectangle {
  RoundCorner 12
}
skinparam database {
  RoundCorner 12
}
skinparam package {
  RoundCorner 12
}

skinparam rectangle<<Person>> {
  BackgroundColor #08427B
  FontColor #FFFFFF
  BorderColor #052E56
}

skinparam rectangle<<System>> {
  BackgroundColor #1168BD
  FontColor #FFFFFF
  BorderColor #0B4884
}

skinparam rectangle<<Container>> {
  BackgroundColor #438DD5
  FontColor #FFFFFF
  BorderColor #2E6295
}

skinparam database<<Database>> {
  BackgroundColor #438DD5
  FontColor #FFFFFF
  BorderColor #2E6295
}

!procedure LAYOUT_TOP_DOWN()
top to bottom direction
!endprocedure

!procedure Person($alias, $label, $descr)
rectangle "**$label**\n//Person//\n$descr" as $alias <<Person>>
!endprocedure

!procedure System($alias, $label, $descr)
rectangle "**$label**\n//Software System//\n$descr" as $alias <<System>>
!endprocedure

!procedure Container($alias, $label, $technology, $descr)
rectangle "**$label**\n//Container: $technology//\n$descr" as $alias <<Container>>
!endprocedure

!procedure ContainerDb($alias, $label, $technology, $descr)
database "**$label**\n//Container: $technology//\n$descr" as $alias <<Database>>
!endprocedure

!procedure Rel($from, $to, $label, $technology="")
$from --> $to : $label\n$technology
!endprocedure
